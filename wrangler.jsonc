{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "striid-games",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "build": {
    "command": "npm run build"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "COMMUNITY_DB",
      "database_name": "striid-games-community",
      "database_id": "2742651a-ea18-435b-9deb-8b03ba324b04",
      "migrations_dir": "migrations"
    }
  ]
}
